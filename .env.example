DATABASE_URL=postgresql://spendwise:local-development-only@127.0.0.1:5432/spendwise?schema=public
POSTGRES_PASSWORD=local-development-only
APP_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
# Never enable demo data on a public production deployment.
ALLOW_DEMO_DATA=true
# Only trust this header if a controlled reverse proxy overwrites it.
TRUST_PROXY=false
INVITE_PEPPER=replace-with-at-least-32-random-characters
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_DAILY_BUDGET_FEN=3000
# Conservative per-attempt reservation, NOT a measurement of provider billing.
LLM_RESERVATION_FEN=100
LLM_USER_DAILY_LIMIT=20

# Official providers. Never put secrets in NEXT_PUBLIC_* variables.
TAOBAO_APP_KEY=
TAOBAO_APP_SECRET=
TAOBAO_ADZONE_ID=
# Reserved configuration; JD/PDD protocols must be verified before enabling.
JD_APP_KEY=
JD_APP_SECRET=
JD_SITE_ID=
PDD_CLIENT_ID=
PDD_CLIENT_SECRET=
PDD_PID=
# Set true only after verifying this application's comparison/data retention permission.
TAOBAO_ACCESS_APPROVED=false
# Configure within the actual platform quota; zero disables requests.
SHOPPING_PLATFORM_DAILY_LIMIT=0
SHOPPING_USER_DAILY_LIMIT=40
