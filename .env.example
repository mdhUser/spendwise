DATABASE_URL=postgresql://spendwise:local-development-only@127.0.0.1:5432/spendwise?schema=public
POSTGRES_PASSWORD=local-development-only
APP_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
# Never enable demo data on a public production deployment.
ALLOW_DEMO_DATA=true
# Only trust this header if a controlled reverse proxy overwrites it.
TRUST_PROXY=false
INVITE_PEPPER=replace-with-at-least-32-random-characters
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_DAILY_BUDGET_FEN=3000
# Conservative per-attempt reservation, NOT a measurement of provider billing.
LLM_RESERVATION_FEN=100
LLM_USER_DAILY_LIMIT=20
